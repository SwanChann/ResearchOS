{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "authors", "venue", "year", "source", "tags", "status", "core_operator", "primary_logic", "verified_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "venue": {"type": ["string", "null"]},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "source": {"type": "object", "required": ["url", "local_pdf"], "properties": {"url": {"type": ["string", "null"]}, "local_pdf": {"type": "string"}}, "additionalProperties": false},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["unread", "skimmed", "verified"]},
    "core_operator": {"type": ["string", "null"]},
    "primary_logic": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
