{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "authors", "venue", "year", "source", "tags", "status", "core_operator", "primary_logic", "verified_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"type": "string"}},
    "venue": {"type": ["string", "null"]},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "source": {
      "type": "object",
      "required": ["url", "local_pdf"],
      "properties": {
        "url": {"type": ["string", "null"]},
        "local_pdf": {"type": ["string", "null"]},
        "zotero": {
          "type": "object",
          "required": ["server_id", "library", "item_key", "item_version", "linked_at"],
          "properties": {
            "server_id": {"type": ["string", "null"]},
            "library": {"type": "string", "pattern": "^(users/0|groups/[0-9]+)$"},
            "item_key": {"type": "string", "minLength": 1},
            "item_version": {"type": ["integer", "null"]},
            "linked_at": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "document": {
          "type": "object",
          "required": ["sha256", "version", "page_count", "citation_basis", "inspected_at"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
            "version": {"type": "string", "minLength": 1},
            "page_count": {"type": "integer", "minimum": 1},
            "citation_basis": {"const": "pdf_page"},
            "inspected_at": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["unread", "skimmed", "verified"]},
    "core_operator": {"type": ["string", "null"]},
    "primary_logic": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"]}
    ,
    "verification": {
      "type": "object",
      "required": ["contract_valid", "source_verified", "fingerprint_verified", "semantic_review_pending", "human_reviewed", "reproduction_unverified", "scientific_claim_unestablished"],
      "properties": {
        "contract_valid": {"type": "boolean"},
        "source_verified": {"type": "boolean"},
        "fingerprint_verified": {"type": "boolean"},
        "semantic_review_pending": {"type": "boolean"},
        "human_reviewed": {"type": "boolean"},
        "reproduction_unverified": {"type": "boolean"},
        "scientific_claim_unestablished": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "decision", "reviewed_at", "scope", "notes", "notes_path", "reviewed_source_fingerprint"],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "decision": {"enum": ["accepted", "revision_requested", "rejected"]},
          "reviewed_at": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "notes": {"type": ["string", "null"]},
          "notes_path": {"type": ["string", "null"]},
          "reviewed_source_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
