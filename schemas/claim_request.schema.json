{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "statement", "scope", "qualifiers", "supporting_findings", "counter_findings", "metric_evidence", "status", "supersedes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["datasets", "platforms", "seeds", "conditions"],
      "properties": {
        "datasets": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "platforms": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "seeds": {"type": "array", "items": {"type": ["integer", "string"]}, "minItems": 1, "uniqueItems": true},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "qualifiers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "supporting_findings": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[0-9]{4}$"}, "minItems": 1, "uniqueItems": true},
    "counter_findings": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[0-9]{4}$"}, "uniqueItems": true},
    "metric_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["run_id", "artifact_id", "artifact_sha256", "json_pointer", "metric_id", "value", "unit"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
          "artifact_id": {"type": "string", "pattern": "^ARTIFACT-[0-9]{4}$"},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "json_pointer": {"type": "string", "pattern": "^/"},
          "metric_id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"},
          "value": {"type": ["number", "string", "boolean", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "tolerance": {"type": "number", "minimum": 0},
          "alias_map": {
            "type": "object",
            "required": ["path", "version", "sha256", "alias"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "alias": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "status": {"const": "draft"},
    "supersedes": {"type": ["string", "null"], "pattern": "^CLAIM-[0-9]{4}$"},
    "body": {"type": "string"}
  },
  "additionalProperties": false
}
