{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "corpus_id", "corpus_fingerprint", "rationale", "cases", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$"},
    "corpus_id": {"type": "string", "pattern": "^CORPUS-[0-9]{4}$"},
    "corpus_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rationale": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "relation", "to", "expected", "rationale"],
        "properties": {
          "from": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
          "relation": {"enum": ["same_problem", "same_method_family", "extends_method", "replaces_component", "shares_assumption", "relaxes_assumption", "same_evaluation", "contradicts_result", "addresses_limitation", "exposes_failure", "counterevidence", "boundary_case"]},
          "to": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
          "expected": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewer", "reviewed_fingerprint", "rationale", "reviewed_at"],
      "properties": {
        "reviewer": {"type": "string", "pattern": "^human:.+"},
        "reviewed_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rationale": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
