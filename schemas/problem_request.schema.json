{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "objective", "scope", "constraints", "application_context", "status", "supersedes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "application_context": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "inactive"]},
    "supersedes": {"type": ["string", "null"], "pattern": "^PROB-[0-9]{4}$"},
    "body": {"type": "string"}
  },
  "additionalProperties": false
}
