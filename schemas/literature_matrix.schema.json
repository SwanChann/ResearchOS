{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["pages", "claim_ids", "locator"],
      "properties": {
        "paper_id": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
        "pages": {"type": "string", "pattern": "^pp?\\.\\s*[0-9]+"},
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^C[0-9]{2}$"}
        },
        "locator": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": ["status", "text", "evidence"],
      "properties": {
        "status": {"enum": ["supported", "not_reported", "not_applicable"]},
        "text": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "additionalProperties": false
    },
    "cross_evidence_ref": {
      "allOf": [
        {"$ref": "#/$defs/evidence_ref"},
        {"required": ["paper_id"]}
      ]
    }
  },
  "type": "object",
  "required": [
    "schema_version", "id", "title", "scope", "status", "citation_basis",
    "axes", "papers", "syntheses", "ideas", "updated_at"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "id": {"type": "string", "pattern": "^LITMATRIX-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "frozen"]},
    "citation_basis": {"const": "pdf_page"},
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "group"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "group": {"enum": ["framing", "method", "evidence", "decision"]},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id", "citation", "title", "year", "stable_id", "source_version",
          "source_sha256", "role", "decision", "next_checks", "cells"
        ],
        "properties": {
          "paper_id": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
          "citation": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "year": {"type": ["integer", "null"]},
          "stable_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
          "role": {"type": "string", "minLength": 1},
          "decision": {"enum": ["central", "supporting", "background", "exclude"]},
          "next_checks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "cells": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/$defs/cell"}
          },
          "superseded_cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["axis_id", "cell", "superseded_by_migration"],
              "properties": {
                "axis_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "cell": {"$ref": "#/$defs/cell"},
                "superseded_by_migration": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "syntheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "strength", "evidence", "caveat"],
        "properties": {
          "id": {"type": "string", "pattern": "^SYN-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 1},
          "strength": {"enum": ["analyst_inference", "paper_consensus", "paper_disagreement"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/cross_evidence_ref"}
          },
          "caveat": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "trigger", "mechanism", "falsification", "risks", "novelty", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^XIDEA-[0-9]{3,4}$"},
          "title": {"type": "string", "minLength": 1},
          "trigger": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "falsification": {"type": "string", "minLength": 1},
          "risks": {"type": "string", "minLength": 1},
          "novelty": {"enum": ["unchecked", "checked"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/cross_evidence_ref"}
          }
        },
        "additionalProperties": false
      }
    },
    "axes_version": {"type": "string", "minLength": 1},
    "axes_source": {
      "type": "object",
      "required": ["kind", "name", "sha256"],
      "properties": {
        "kind": {"enum": ["template", "file"]},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "axes_locked": {"type": "boolean"},
    "axes_migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_axes_version", "to_axes_version", "at", "mapping", "preserved_superseded_cells", "new_review_placeholders", "source_file"],
        "properties": {
          "from_axes_version": {"type": "string", "minLength": 1},
          "to_axes_version": {"type": "string", "minLength": 1},
          "at": {"type": "string", "minLength": 1},
          "mapping": {"type": "object", "additionalProperties": {"type": "string"}},
          "preserved_superseded_cells": {"type": "integer", "minimum": 0},
          "new_review_placeholders": {"type": "integer", "minimum": 0},
          "source_file": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "decision", "reviewed_at", "scope", "notes", "notes_path", "reviewed_source_fingerprint"],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "decision": {"enum": ["accepted", "revision_requested", "rejected"]},
          "reviewed_at": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "notes": {"type": ["string", "null"]},
          "notes_path": {"type": ["string", "null"]},
          "reviewed_source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
