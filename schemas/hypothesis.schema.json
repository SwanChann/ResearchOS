{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "status", "based_on", "created", "updated", "title"],
  "properties": {
    "id": {"type": "string", "pattern": "^HYP-[0-9]{4}$"},
    "status": {"enum": ["proposed", "testing", "supported", "rejected", "inconclusive"]},
    "based_on": {
      "type": "object",
      "properties": {
        "observations": {"type": "array", "items": {"type": "string", "pattern": "^OBS-[0-9]{4}$"}},
        "papers": {"type": "array", "items": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"}},
        "ideas": {"type": "array", "items": {"type": "string", "pattern": "^XIDEA-[0-9]{3,4}$"}},
        "gaps": {"type": "array", "items": {"type": "string", "pattern": "^GAP-[0-9]{4}$"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "created": {"type": "string"},
    "updated": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["derivation", "local_empirical_support", "idea_sources", "warnings"],
      "properties": {
        "derivation": {"enum": ["literature-derived", "local-observation-derived", "mixed"]},
        "local_empirical_support": {"type": "boolean"},
        "idea_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "matrix_id", "matrix_fingerprint", "idea_fingerprint", "novelty", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^XIDEA-[0-9]{3,4}$"},
              "matrix_id": {"type": "string", "pattern": "^LITMATRIX-[0-9]{4}$"},
              "matrix_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "idea_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "novelty": {"enum": ["unchecked", "checked"]},
              "evidence": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": false
          }
        },
        "gap_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "gap_fingerprint", "reviewer", "reviewed_at"],
            "properties": {
              "id": {"type": "string", "pattern": "^GAP-[0-9]{4}$"},
              "gap_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "reviewer": {"type": "string", "pattern": "^human:.+"},
              "reviewed_at": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
