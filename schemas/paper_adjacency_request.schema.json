{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["page", "section", "figure", "table", "paragraph", "path"]},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["paper_id", "tuple_ids", "claim_ids", "locators"],
      "properties": {
        "paper_id": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
        "tuple_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^TUPLE-[0-9a-f]{12}$"},
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C[0-9]{2}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "locators": {"type": "array", "items": {"$ref": "#/$defs/locator"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["deterministic_structural", "human", "agent_import", "tool_import"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["structural", "semantic", "overall", "basis"],
      "properties": {
        "structural": {"type": "number", "minimum": 0, "maximum": 1},
        "semantic": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "overall": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["corpus_id", "from", "relation", "to", "directed", "dimensions", "evidence", "rationale", "score", "generator"],
  "properties": {
    "corpus_id": {"type": "string", "pattern": "^CORPUS-[0-9]{4}$"},
    "from": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
    "relation": {
      "enum": ["same_problem", "same_method_family", "extends_method", "replaces_component", "shares_assumption", "relaxes_assumption", "same_evaluation", "contradicts_result", "addresses_limitation", "exposes_failure", "counterevidence", "boundary_case"]
    },
    "to": {"type": "string", "pattern": "^PAPER-[0-9]{4}$"},
    "directed": {"type": "boolean"},
    "dimensions": {"type": "array", "items": {"enum": ["problem", "method", "component", "assumption", "task", "dataset", "metric", "evaluation", "result", "limitation", "failure_condition", "boundary"]}, "minItems": 1, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 2},
    "rationale": {"type": "string", "minLength": 1},
    "score": {"$ref": "#/$defs/score"},
    "generator": {"$ref": "#/$defs/generator"}
  },
  "additionalProperties": false
}
